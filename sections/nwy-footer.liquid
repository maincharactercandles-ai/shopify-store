{% liquid
  assign section_id = 'nwy-footer-' | append: section.id
  assign current_year = 'now' | date: '%Y'
%}

<footer
  id="{{ section_id }}"
  class="nwy-footer"
  style="
    --nwy-footer-bg: {{ section.settings.background_color }};
    --nwy-footer-text: {{ section.settings.text_color }};
    --nwy-footer-border: {{ section.settings.border_color }};
    --nwy-footer-input-bg: {{ section.settings.input_background }};
    --nwy-footer-input-text: {{ section.settings.input_text_color }};
    --nwy-footer-pt: {{ section.settings.padding_top }}px;
    --nwy-footer-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="nwy-footer__container">

    {% if section.settings.show_statement and section.settings.statement != blank %}
      <div class="nwy-footer__statement">
        <p>{{ section.settings.statement | escape }}</p>
      </div>
    {% endif %}

    <div class="nwy-footer__divider"></div>

    <div class="nwy-footer__main">

      <div class="nwy-footer__brand">
        {% if section.settings.brand_title != blank %}
          <p class="nwy-footer__brand-title">
            {{ section.settings.brand_title | escape }}
          </p>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <div class="nwy-footer__brand-text">
            {{ section.settings.brand_text }}
          </div>
        {% endif %}

        {% if section.settings.location != blank %}
          <p class="nwy-footer__location">
            {{ section.settings.location | escape }}
          </p>
        {% endif %}
      </div>

      <nav
        class="nwy-footer__navigation"
        aria-label="Footer navigation"
      >
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu' %}
              <div
                class="nwy-footer__column"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.heading != blank %}
                  <p class="nwy-footer__column-title">
                    {{ block.settings.heading | escape }}
                  </p>
                {% endif %}

                {% if block.settings.menu != blank %}
                  <ul class="nwy-footer__links" role="list">
                    {% for link in block.settings.menu.links %}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="nwy-footer__link{% if link.current %} is-active{% endif %}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </nav>

    </div>

    {% if section.settings.show_newsletter %}
      <div class="nwy-footer__newsletter">

        <div class="nwy-footer__newsletter-copy">
          {% if section.settings.newsletter_eyebrow != blank %}
            <p class="nwy-footer__eyebrow">
              {{ section.settings.newsletter_eyebrow | escape }}
            </p>
          {% endif %}

          {% if section.settings.newsletter_heading != blank %}
            <h2 class="nwy-footer__newsletter-heading">
              {{ section.settings.newsletter_heading | escape | newline_to_br }}
            </h2>
          {% endif %}

          {% if section.settings.newsletter_text != blank %}
            <div class="nwy-footer__newsletter-text">
              {{ section.settings.newsletter_text }}
            </div>
          {% endif %}
        </div>

        <div class="nwy-footer__form-wrapper">
          {% form 'customer', class: 'nwy-footer__form' %}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <div class="nwy-footer__field">
              <label
                class="visually-hidden"
                for="NwyFooterEmail-{{ section.id }}"
              >
                {{ section.settings.email_label | escape }}
              </label>

              <input
                id="NwyFooterEmail-{{ section.id }}"
                class="nwy-footer__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="NwyFooterError-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="NwyFooterSuccess-{{ section.id }}"
                {% endif %}
              >

              <button
                class="nwy-footer__submit"
                type="submit"
                name="commit"
                aria-label="{{ section.settings.submit_label | escape }}"
              >
                <span>{{ section.settings.submit_label | escape }}</span>

                <svg
                  aria-hidden="true"
                  viewBox="0 0 18 18"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M3 9H15M10 4L15 9L10 14"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="square"
                    stroke-linejoin="miter"
                  />
                </svg>
              </button>
            </div>

            {% if form.errors %}
              <p
                id="NwyFooterError-{{ section.id }}"
                class="nwy-footer__message nwy-footer__message--error"
                role="alert"
              >
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {% endif %}

            {% if form.posted_successfully? %}
              <p
                id="NwyFooterSuccess-{{ section.id }}"
                class="nwy-footer__message nwy-footer__message--success"
                role="status"
              >
                {{ section.settings.success_message | escape }}
              </p>
            {% endif %}
          {% endform %}
        </div>

      </div>
    {% endif %}

    <div class="nwy-footer__divider"></div>

    <div class="nwy-footer__bottom">

      <div class="nwy-footer__socials">
        {% if section.settings.instagram_url != blank %}
          <a
            href="{{ section.settings.instagram_url }}"
            class="nwy-footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        {% endif %}

        {% if section.settings.pinterest_url != blank %}
          <a
            href="{{ section.settings.pinterest_url }}"
            class="nwy-footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Pinterest
          </a>
        {% endif %}

        {% if section.settings.tiktok_url != blank %}
          <a
            href="{{ section.settings.tiktok_url }}"
            class="nwy-footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            TikTok
          </a>
        {% endif %}
      </div>

      <div class="nwy-footer__legal">
        <p>
          © {{ current_year }}
          {{ section.settings.copyright_name | default: shop.name | escape }}
        </p>

        {% if section.settings.bottom_note != blank %}
          <p>{{ section.settings.bottom_note | escape }}</p>
        {% endif %}
      </div>

    </div>

  </div>
</footer>

{% style %}

  /* =========================================================
     NWYE FOOTER — COMPACT VERSION
     ========================================================= */

  #{{ section_id }} {
    position: relative;
    overflow: hidden;
    padding-top: clamp(34px, 3.5vw, 54px);
    padding-bottom: 18px;
    background: var(--nwy-footer-bg);
    color: var(--nwy-footer-text);
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} p,
  #{{ section_id }} h2,
  #{{ section_id }} ul {
    margin-top: 0;
  }

  #{{ section_id }} .nwy-footer__container {
    width: min(100%, 1860px);
    margin: 0 auto;
    padding-inline: clamp(20px, 4vw, 72px);
  }

  #{{ section_id }} .nwy-footer__divider {
    width: 100%;
    height: 1px;
    background: var(--nwy-footer-border);
  }


  /* =========================================================
     STATEMENT
     ========================================================= */

  #{{ section_id }} .nwy-footer__statement {
    padding-bottom: clamp(32px, 3.5vw, 48px);
  }

  #{{ section_id }} .nwy-footer__statement p {
    max-width: 1500px;
    margin-bottom: 0;

    font-size: clamp(48px, 5vw, 72px);
    font-weight: 500;
    line-height: .88;
    letter-spacing: -.065em;
    text-transform: uppercase;
  }


  /* =========================================================
     MAIN FOOTER
     ========================================================= */

  #{{ section_id }} .nwy-footer__main {
    display: grid;
    grid-template-columns:
      minmax(260px, 1.05fr)
      minmax(520px, 1.65fr);

    gap: clamp(55px, 8vw, 140px);

    padding-block: clamp(34px, 3.5vw, 52px);
  }


  /* BRAND */

  #{{ section_id }} .nwy-footer__brand {
    max-width: 390px;
  }

  #{{ section_id }} .nwy-footer__brand-title {
    margin-bottom: 18px;

    max-width: 290px;

    font-size: clamp(24px, 2vw, 34px);
    font-weight: 650;
    line-height: .92;
    letter-spacing: -.045em;

    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-footer__brand-text {
    max-width: 350px;

    font-size: clamp(14px, 1vw, 17px);
    line-height: 1.45;
  }

  #{{ section_id }} .nwy-footer__brand-text p {
    margin-bottom: 8px;
  }

  #{{ section_id }} .nwy-footer__brand-text p:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .nwy-footer__location {
    margin: 18px 0 0;

    font-size: 9px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: .16em;

    text-transform: uppercase;
  }


  /* =========================================================
     NAVIGATION
     ========================================================= */

  #{{ section_id }} .nwy-footer__navigation {
    display: grid;
    grid-template-columns: repeat(3, minmax(120px, 1fr));
    gap: clamp(30px, 4vw, 70px);
  }

  #{{ section_id }} .nwy-footer__column-title,
  #{{ section_id }} .nwy-footer__eyebrow {
    margin-bottom: 16px;

    font-size: 9px;
    font-weight: 650;
    line-height: 1;
    letter-spacing: .15em;

    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-footer__links {
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  #{{ section_id }} .nwy-footer__links li {
    margin-bottom: 8px;
  }

  #{{ section_id }} .nwy-footer__links li:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .nwy-footer__link,
  #{{ section_id }} .nwy-footer__social-link {
    position: relative;
    display: inline-block;

    color: inherit;

    font-size: 13px;
    line-height: 1.35;
    text-decoration: none;
  }

  #{{ section_id }} .nwy-footer__link::after,
  #{{ section_id }} .nwy-footer__social-link::after {
    position: absolute;

    right: 0;
    bottom: -2px;
    left: 0;

    height: 1px;

    background: currentColor;

    content: "";

    transform: scaleX(0);
    transform-origin: right center;

    transition:
      transform 350ms cubic-bezier(.22, 1, .36, 1);
  }

  #{{ section_id }} .nwy-footer__link:hover::after,
  #{{ section_id }} .nwy-footer__link.is-active::after,
  #{{ section_id }} .nwy-footer__social-link:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }


  /* =========================================================
     NEWSLETTER
     More horizontal / less like a second footer
     ========================================================= */

  #{{ section_id }} .nwy-footer__newsletter {
    display: grid;

    grid-template-columns:
      minmax(300px, .85fr)
      minmax(420px, 1.15fr);

    gap: clamp(50px, 8vw, 150px);

    align-items: end;

    padding-block: clamp(28px, 3vw, 40px);

    border-top: 1px solid var(--nwy-footer-border);
  }

  #{{ section_id }} .nwy-footer__newsletter-copy {
    max-width: 520px;
  }

  #{{ section_id }} .nwy-footer__eyebrow {
    margin-bottom: 10px;
    opacity: .7;
  }

  #{{ section_id }} .nwy-footer__newsletter-heading {
    margin-bottom: 12px;

    font-size: clamp(30px, 3vw, 42px);
    font-weight: 500;
    line-height: .88;
    letter-spacing: -.055em;

    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-footer__newsletter-text {
    max-width: 390px;

    font-size: clamp(13px, .95vw, 15px);
    line-height: 1.4;

    opacity: .82;
  }

  #{{ section_id }} .nwy-footer__newsletter-text p {
    margin-bottom: 0;
  }


  /* =========================================================
     NEWSLETTER FORM
     ========================================================= */

  #{{ section_id }} .nwy-footer__form-wrapper {
    width: 100%;
    max-width: 620px;

    justify-self: end;
  }

  #{{ section_id }} .nwy-footer__field {
    display: flex;

    width: 100%;
    min-height: 46px;

    border-bottom: 1px solid var(--nwy-footer-text);
  }

  #{{ section_id }} .nwy-footer__input {
    min-width: 0;
    flex: 1 1 auto;

    border: 0;
    border-radius: 0;
    outline: none;

    padding: 10px 10px 10px 0;

    background: transparent;
    box-shadow: none;

    color: inherit;

    font: inherit;
    font-size: 14px;
  }

  #{{ section_id }} .nwy-footer__input::placeholder {
    color: inherit;
    opacity: .5;
  }

  #{{ section_id }} .nwy-footer__submit {
    display: inline-flex;

    flex: 0 0 auto;

    align-items: center;

    gap: 12px;

    border: 0;

    padding: 8px 0 8px 18px;

    background: transparent;
    color: inherit;

    cursor: pointer;

    font: inherit;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: .13em;

    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-footer__submit svg {
    width: 15px;
    height: 15px;

    transition:
      transform 300ms cubic-bezier(.22, 1, .36, 1);
  }

  #{{ section_id }} .nwy-footer__submit:hover svg {
    transform: translateX(5px);
  }

  #{{ section_id }} .nwy-footer__message {
    margin: 10px 0 0;

    font-size: 12px;
    line-height: 1.4;
  }

  #{{ section_id }} .nwy-footer__message--error {
    text-decoration: underline;
    text-underline-offset: 3px;
  }


  /* =========================================================
     BOTTOM
     ========================================================= */

  #{{ section_id }} .nwy-footer__bottom {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 40px;

    padding-top: 16px;
  }

  #{{ section_id }} .nwy-footer__socials {
    display: flex;
    flex-wrap: wrap;

    gap: 22px;
  }

  #{{ section_id }} .nwy-footer__social-link {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .11em;

    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-footer__legal {
    display: flex;
    flex-wrap: wrap;

    justify-content: flex-end;

    gap: 8px 22px;

    text-align: right;
  }

  #{{ section_id }} .nwy-footer__legal p {
    margin-bottom: 0;

    font-size: 8px;
    line-height: 1.3;
    letter-spacing: .10em;

    text-transform: uppercase;

    opacity: .75;
  }


  /* =========================================================
     ACCESSIBILITY
     ========================================================= */

  #{{ section_id }} .visually-hidden {
    position: absolute !important;

    width: 1px !important;
    height: 1px !important;

    overflow: hidden !important;

    clip: rect(0 0 0 0) !important;
    clip-path: inset(50%) !important;

    white-space: nowrap !important;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 989px) {

    #{{ section_id }} .nwy-footer__main {
      grid-template-columns: 1fr;
      gap: 40px;

      padding-block: 40px;
    }

    #{{ section_id }} .nwy-footer__brand {
      max-width: 520px;
    }

    #{{ section_id }} .nwy-footer__navigation {
      gap: 30px;
    }

    #{{ section_id }} .nwy-footer__newsletter {
      grid-template-columns: .85fr 1.15fr;
      gap: 40px;
    }

    #{{ section_id }} .nwy-footer__form-wrapper {
      max-width: none;
    }
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #{{ section_id }} {
      padding-top: 38px;
      padding-bottom: 18px;
    }

    #{{ section_id }} .nwy-footer__container {
      padding-inline: 20px;
    }


    /* STATEMENT */

    #{{ section_id }} .nwy-footer__statement {
      padding-bottom: 32px;
    }

    #{{ section_id }} .nwy-footer__statement p {
      font-size: clamp(42px, 13vw, 60px);
      line-height: .86;
    }


    /* MAIN */

    #{{ section_id }} .nwy-footer__main {
      gap: 36px;
      padding-block: 34px;
    }

    #{{ section_id }} .nwy-footer__brand-title {
      max-width: 220px;

      margin-bottom: 15px;

      font-size: 27px;
    }

    #{{ section_id }} .nwy-footer__brand-text {
      max-width: 330px;

      font-size: 14px;
    }

    #{{ section_id }} .nwy-footer__location {
      margin-top: 16px;
    }


    /* MENUS */

    #{{ section_id }} .nwy-footer__navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 32px 20px;
    }

    #{{ section_id }} .nwy-footer__column:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    #{{ section_id }} .nwy-footer__column-title {
      margin-bottom: 15px;
    }

    #{{ section_id }} .nwy-footer__links li {
      margin-bottom: 8px;
    }

    #{{ section_id }} .nwy-footer__link {
      font-size: 13px;
    }


    /* NEWSLETTER */

    #{{ section_id }} .nwy-footer__newsletter {
      grid-template-columns: 1fr;

      gap: 26px;

      padding-block: 32px;
    }

    #{{ section_id }} .nwy-footer__newsletter-heading {
      max-width: 280px;

      margin-bottom: 10px;

      font-size: 36px;
      line-height: .88;
    }

    #{{ section_id }} .nwy-footer__newsletter-text {
      max-width: 320px;

      font-size: 14px;
    }

    #{{ section_id }} .nwy-footer__field {
      min-height: 48px;
    }

    #{{ section_id }} .nwy-footer__input {
      width: 100%;

      font-size: 14px;
    }

    #{{ section_id }} .nwy-footer__submit {
      gap: 8px;
      padding-left: 12px;
    }

    #{{ section_id }} .nwy-footer__submit span {
      display: none;
    }

    #{{ section_id }} .nwy-footer__submit svg {
      width: 19px;
      height: 19px;
    }


    /* BOTTOM */

    #{{ section_id }} .nwy-footer__bottom {
      flex-direction: column;

      align-items: flex-start;

      gap: 16px;

      padding-top: 16px;
    }

    #{{ section_id }} .nwy-footer__socials {
      gap: 18px;
    }

    #{{ section_id }} .nwy-footer__legal {
      flex-direction: column;

      align-items: flex-start;
      justify-content: flex-start;

      gap: 5px;

      text-align: left;
    }
  }


  @media screen and (max-width: 420px) {

    #{{ section_id }} .nwy-footer__navigation {
      grid-template-columns: 1fr 1fr;
    }

  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    #{{ section_id }} .nwy-footer__link::after,
    #{{ section_id }} .nwy-footer__social-link::after,
    #{{ section_id }} .nwy-footer__submit svg {
      transition: none;
    }

  }

{% endstyle %}

{% schema %}
{
  "name": "NWY — Footer",
  "tag": "section",
  "class": "section-nwy-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Large statement"
    },
    {
      "type": "checkbox",
      "id": "show_statement",
      "label": "Show large statement",
      "default": true
    },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Statement",
      "default": "DESIGNED TO STAY."
    },
    {
      "type": "header",
      "content": "Brand information"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title",
      "default": "NOT WHAT YOU EXPECT."
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand description",
      "default": "<p>Industrial objects transformed into collectible scented candles.</p><p>Hand-poured in Paris.</p>"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "PARIS, FRANCE"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Small title",
      "default": "STAY UNEXPECTED"
    },
    {
      "type": "textarea",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "DON'T EXPECT\nSPAM."
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Text",
      "default": "<p>Get early access to new objects, limited drops and studio updates.</p>"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email accessibility label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "YOUR EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "JOIN"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "YOU'RE ON THE LIST."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Bottom information"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "NOT WHAT YOU EXPECT."
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom note",
      "default": "HAND-POURED IN PARIS."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F4F3EF"
    },
    {
