<section
  id="nwy-article-links-{{ section.id }}"
  class="nwy-article-links color-{{ section.settings.color_scheme }}"
>
  <div class="nwy-article-links__inner">

    {% if section.settings.heading != blank %}
      <p class="nwy-article-links__heading">
        {{ section.settings.heading }}
      </p>
    {% endif %}

    <nav class="nwy-article-links__nav" aria-label="Continue exploring">

      {% if section.settings.collection_label != blank and section.settings.collection_link != blank %}
        <a
          class="nwy-article-links__link"
          href="{{ section.settings.collection_link }}"
        >
          <span class="nwy-article-links__arrow" aria-hidden="true">→</span>
          <span>{{ section.settings.collection_label }}</span>
        </a>
      {% endif %}

      {% if section.settings.concept_label != blank and section.settings.concept_link != blank %}
        <a
          class="nwy-article-links__link"
          href="{{ section.settings.concept_link }}"
        >
          <span class="nwy-article-links__arrow" aria-hidden="true">→</span>
          <span>{{ section.settings.concept_label }}</span>
        </a>
      {% endif %}

      {% if section.settings.story_label != blank and section.settings.story_link != blank %}
        <a
          class="nwy-article-links__link"
          href="{{ section.settings.story_link }}"
        >
          <span class="nwy-article-links__arrow" aria-hidden="true">→</span>
          <span>{{ section.settings.story_label }}</span>
        </a>
      {% endif %}

    </nav>

  </div>
</section>

<style>
  #nwy-article-links-{{ section.id }} {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  #nwy-article-links-{{ section.id }} *,
  #nwy-article-links-{{ section.id }} *::before,
  #nwy-article-links-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__inner {
    width: min(100% - 64px, 1180px);
    margin: 0 auto;
    padding: 64px 0 72px;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__heading {
    margin: 0 0 30px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.42;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__nav {
    display: grid;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__link {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    min-height: 82px;
    padding: 18px 0;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    color: inherit;
    text-decoration: none;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 3.4vw, 54px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    transition: opacity 180ms ease;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__link:last-child {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__link:hover {
    opacity: 0.55;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__arrow {
    font-family: var(--font-body-family);
    font-size: 21px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    transition: transform 180ms ease;
  }

  #nwy-article-links-{{ section.id }} .nwy-article-links__link:hover .nwy-article-links__arrow {
    transform: translateX(6px);
  }

  @media screen and (max-width: 749px) {
    #nwy-article-links-{{ section.id }} .nwy-article-links__inner {
      width: min(100% - 40px, 1180px);
      padding: 48px 0 56px;
    }

    #nwy-article-links-{{ section.id }} .nwy-article-links__heading {
      margin-bottom: 22px;
      font-size: 10px;
    }

    #nwy-article-links-{{ section.id }} .nwy-article-links__link {
      grid-template-columns: 26px minmax(0, 1fr);
      min-height: 66px;
      padding: 16px 0;
      font-size: clamp(25px, 8.5vw, 38px);
      line-height: 0.98;
    }

    #nwy-article-links-{{ section.id }} .nwy-article-links__arrow {
      font-size: 17px;
    }
  }
</style>

{% schema %}
{
  "name": "NWY — Article links",
  "tag": "section",
  "class": "section-nwy-article-links",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Continue exploring"
    },
    {
      "type": "header",
      "content": "Current collection"
    },
    {
      "type": "text",
      "id": "collection_label",
      "label": "Label",
      "default": "Current collection"
    },
    {
      "type": "url",
      "id": "collection_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Concept"
    },
    {
      "type": "text",
      "id": "concept_label",
      "label": "Label",
      "default": "The Concept"
    },
    {
      "type": "url",
      "id": "concept_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Label",
      "default": "The Story"
    },
    {
      "type": "url",
      "id": "story_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "NWY — Article links"
    }
  ]
}
{% endschema %}
