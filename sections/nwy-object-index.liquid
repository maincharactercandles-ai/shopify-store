{% liquid
  assign section_id = 'nwy-object-index-' | append: section.id
%}

<section id="{{ section_id }}" class="nwy-object-index color-{{ section.settings.color_scheme }}">
  <div class="nwy-object-index__container">

    <!-- HERO -->
    <header class="nwy-object-index__hero">
      <div class="nwy-object-index__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="nwy-object-index__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="nwy-object-index__heading">{{ section.settings.heading }}</h1>
        {% endif %}
      </div>

      {% if section.settings.intro != blank %}
        <div class="nwy-object-index__intro rte">
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </header>

    <!-- OBJECT INDEX -->
    <div class="nwy-object-index__grid">
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'object' %}
            {% liquid
              assign index_product = block.settings.product
              assign object_title = block.settings.title
              assign object_link = block.settings.link
              assign object_image = block.settings.image
              assign object_subtitle = block.settings.subtitle

              if index_product != blank
                assign object_link = index_product.url

                if block.settings.use_product_title
                  assign object_title = index_product.title | split: ' — ' | first | split: ' - ' | first
                endif

                if object_image == blank
                  assign object_image = index_product.featured_image
                endif

                assign perfume_reference = index_product.metafields[section.settings.perfume_namespace][section.settings.perfume_key]

                if perfume_reference != blank
                  assign perfume_value = perfume_reference.value

                  if perfume_value != blank
                    assign perfume_text_field = perfume_value[section.settings.perfume_text_field]

                    if perfume_text_field != blank
                      assign object_subtitle = perfume_text_field.value | default: perfume_text_field
                    elsif perfume_value.system.handle != blank
                      assign object_subtitle = perfume_value.system.handle | replace: '-', ' ' | capitalize
                    endif
                  endif
                endif
              endif
            %}

            <article class="nwy-object-index__card" {{ block.shopify_attributes }}>
              {% if object_link != blank %}
                <a
                  href="{{ object_link }}"
                  class="nwy-object-index__card-link"
                  aria-label="View {{ object_title | escape }}"
                >
              {% else %}
                <div class="nwy-object-index__card-link">
              {% endif %}

                <div class="nwy-object-index__topline">
                  <span class="nwy-object-index__number">{{ block.settings.number }}</span>

                  {% if block.settings.year != blank %}
                    <span class="nwy-object-index__year">{{ block.settings.year }}</span>
                  {% endif %}
                </div>

                <div class="nwy-object-index__card-media">
                  {% if object_image != blank %}
                    {{
                      object_image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'nwy-object-index__card-image',
                        loading: 'lazy',
                        widths: '480, 720, 960, 1200, 1600',
                        sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw',
                        alt: object_image.alt | default: object_title
                    }}
                  {% else %}
                    <div class="nwy-object-index__placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'nwy-object-index__placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>

                <div class="nwy-object-index__card-copy">
                  {% if object_title != blank %}
                    <h2 class="nwy-object-index__card-title">{{ object_title }}</h2>
                  {% endif %}

                  {% if object_subtitle != blank %}
                    <p class="nwy-object-index__subtitle">{{ object_subtitle }}</p>
                  {% endif %}
                </div>

              {% if object_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </article>

          {% when 'coming_soon' %}
            <article class="nwy-object-index__card nwy-object-index__card--coming" {{ block.shopify_attributes }}>
              <div class="nwy-object-index__card-link">

                <div class="nwy-object-index__topline">
                  <span class="nwy-object-index__number">{{ block.settings.number }}</span>

                  {% if block.settings.year != blank %}
                    <span class="nwy-object-index__year">{{ block.settings.year }}</span>
                  {% endif %}
                </div>

                <div class="nwy-object-index__coming-visual">
                  <div class="nwy-object-index__coming-light"></div>

                  <div class="nwy-object-index__coming-copy">
                    <strong>{{ block.settings.heading }}</strong>

                    {% if block.settings.text != blank %}
                      <span>{{ block.settings.text }}</span>
                    {% endif %}

                    <i aria-hidden="true"></i>
                    <small>NOT WHAT YOU EXPECT.</small>
                  </div>
                </div>

                <div class="nwy-object-index__card-copy">
                  {% if block.settings.footer_title != blank %}
                    <h2 class="nwy-object-index__card-title">{{ block.settings.footer_title }}</h2>
                  {% endif %}

                  {% if block.settings.footer_text != blank %}
                    <p class="nwy-object-index__subtitle">{{ block.settings.footer_text }}</p>
                  {% endif %}
                </div>

              </div>
            </article>

        {% endcase %}
      {% endfor %}
    </div>

    <!-- MANIFESTO -->
    <section class="nwy-object-index__manifesto">
      {% if section.settings.manifesto_eyebrow != blank %}
        <p class="nwy-object-index__eyebrow">{{ section.settings.manifesto_eyebrow }}</p>
      {% endif %}

      <div class="nwy-object-index__manifesto-grid">
        {% if section.settings.manifesto_heading != blank %}
          <h2>{{ section.settings.manifesto_heading }}</h2>
        {% endif %}

        {% if section.settings.manifesto_text != blank %}
          <div class="nwy-object-index__manifesto-text rte">
            {{ section.settings.manifesto_text }}
          </div>
        {% endif %}
      </div>
    </section>

  </div>
</section>

<style>
  #{{ section_id }} {
    --nwy-border: rgb(var(--color-foreground-rgb) / 0.16);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-family: var(--font-body-family);
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .nwy-object-index__container {
    width: min(100% - 64px, 1320px);
    margin: 0 auto;
    padding: 84px 0 112px;
  }

  #{{ section_id }} .nwy-object-index__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.55fr);
    gap: 80px;
    align-items: end;
    padding-bottom: 74px;
    border-bottom: 1px solid var(--nwy-border);
  }

  #{{ section_id }} .nwy-object-index__eyebrow {
    margin: 0 0 20px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  #{{ section_id }} .nwy-object-index__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(64px, 9vw, 138px);
    font-weight: 700;
    line-height: 0.84;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-object-index__intro {
    max-width: 420px;
    font-size: 16px;
    line-height: 1.58;
  }

  #{{ section_id }} .nwy-object-index__intro p,
  #{{ section_id }} .nwy-object-index__manifesto-text p {
    margin: 0;
  }

  #{{ section_id }} .nwy-object-index__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 30px;
    row-gap: 104px;
    padding-top: 58px;
  }

  #{{ section_id }} .nwy-object-index__card {
    min-width: 0;
  }

  #{{ section_id }} .nwy-object-index__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #{{ section_id }} .nwy-object-index__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
  }

  #{{ section_id }} .nwy-object-index__number {
    font-family: var(--font-heading-family);
    font-size: clamp(70px, 6.3vw, 104px);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.075em;
  }

  #{{ section_id }} .nwy-object-index__year {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.42;
  }

  #{{ section_id }} .nwy-object-index__card-media,
  #{{ section_id }} .nwy-object-index__coming-visual {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ece8e1;
  }

  #{{ section_id }} .nwy-object-index__card-image,
  #{{ section_id }} .nwy-object-index__placeholder,
  #{{ section_id }} .nwy-object-index__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .nwy-object-index__card-image {
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  #{{ section_id }} .nwy-object-index__card-link:hover .nwy-object-index__card-image {
    transform: scale(1.025);
  }

  #{{ section_id }} .nwy-object-index__placeholder {
    background: #ece8e1;
  }

  #{{ section_id }} .nwy-object-index__placeholder-svg {
    opacity: 0.28;
  }

  #{{ section_id }} .nwy-object-index__card-copy {
    padding-top: 20px;
  }

  #{{ section_id }} .nwy-object-index__card-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(27px, 2.35vw, 40px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-object-index__subtitle {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.45;
    opacity: 0.68;
  }

  /* COMING SOON */
  #{{ section_id }} .nwy-object-index__coming-visual {
    isolation: isolate;
    background: #e9e5df;
  }

  #{{ section_id }} .nwy-object-index__coming-visual::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 22%;
    background:
      radial-gradient(circle at 35% 0%, rgba(255,255,255,0.8), transparent 45%),
      #d8d2ca;
    border-top: 1px solid rgba(17,17,17,0.06);
  }

  #{{ section_id }} .nwy-object-index__coming-light {
    position: absolute;
    inset: -20% -40% auto auto;
    z-index: -1;
    width: 100%;
    height: 75%;
    background: linear-gradient(
      135deg,
      transparent 30%,
      rgba(255,255,255,0.72) 52%,
      transparent 73%
    );
    filter: blur(12px);
    transform: rotate(-8deg);
  }

  #{{ section_id }} .nwy-object-index__coming-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 34px;
    text-align: center;
  }

  #{{ section_id }} .nwy-object-index__coming-copy strong {
    font-size: clamp(21px, 2vw, 32px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
  }

  #{{ section_id }} .nwy-object-index__coming-copy span {
    margin-top: 24px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  #{{ section_id }} .nwy-object-index__coming-copy i {
    display: block;
    width: 34px;
    height: 1px;
    margin: 36px 0;
    background: currentColor;
    opacity: 0.55;
  }

  #{{ section_id }} .nwy-object-index__coming-copy small {
    font-size: 9px;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.24em;
  }

  /* MANIFESTO */
  #{{ section_id }} .nwy-object-index__manifesto {
    margin-top: 126px;
    padding-top: 74px;
    border-top: 1px solid var(--nwy-border);
  }

  #{{ section_id }} .nwy-object-index__manifesto-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    gap: 90px;
    align-items: end;
  }

  #{{ section_id }} .nwy-object-index__manifesto h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(50px, 7vw, 108px);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.065em;
    text-transform: uppercase;
  }

  #{{ section_id }} .nwy-object-index__manifesto-text {
    font-size: 16px;
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .nwy-object-index__hero,
    #{{ section_id }} .nwy-object-index__manifesto-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    #{{ section_id }} .nwy-object-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .nwy-object-index__container {
      width: calc(100% - 40px);
      padding: 56px 0 76px;
    }

    #{{ section_id }} .nwy-object-index__hero {
      padding-bottom: 50px;
    }

    #{{ section_id }} .nwy-object-index__heading {
      font-size: clamp(52px, 16vw, 78px);
    }

    #{{ section_id }} .nwy-object-index__grid {
      grid-template-columns: 1fr;
      row-gap: 76px;
      padding-top: 44px;
    }

    #{{ section_id }} .nwy-object-index__number {
      font-size: 72px;
    }

    #{{ section_id }} .nwy-object-index__card-title {
      font-size: 31px;
    }

    #{{ section_id }} .nwy-object-index__manifesto {
      margin-top: 94px;
      padding-top: 56px;
    }

    #{{ section_id }} .nwy-object-index__manifesto h2 {
      font-size: clamp(44px, 14vw, 68px);
    }
  }
</style>

{% schema %}
