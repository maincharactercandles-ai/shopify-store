  "settings": [

    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },

    {
      "type": "image_picker",
      "id": "burn_image",
      "label": "Burn it image"
    },

    {
      "type": "image_picker",
      "id": "clean_image",
      "label": "Clean it image"
    },

    {
      "type": "url",
      "id": "clean_link",
      "label": "Cleaning guide link"
    },

    {
      "type": "header",
      "content": "Second life images"
    },

    {
      "type": "image_picker",
      "id": "drink_image",
      "label": "Drink image"
    },

    {
      "type": "image_picker",
      "id": "store_image",
      "label": "Store image"
    },

    {
      "type": "image_picker",
      "id": "display_image",
      "label": "Display image"
    },

    {
      "type": "image_picker",
      "id": "whatever_image",
      "label": "Whatever image"
    },

    {
      "type": "header",
      "content": "Final section"
    },

    {
      "type": "image_picker",
      "id": "final_image",
      "label": "Final image"
    },

    {
