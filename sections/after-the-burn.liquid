          "id": "caption",
          "label": "Caption",
          "default": "OBJECT, REUSED."
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "After the burn",

      "blocks": [
        { "type": "use_case" },
        { "type": "use_case" },
        { "type": "use_case" }
      ]

    }

  ]
}
{% endschema %}