<script>

document.addEventListener('DOMContentLoaded', () => {
 const section = document.querySelector('#find-your-object-{{ section.id }}');
 if (!section) return;
 const screens = section.querySelectorAll('[data-screen]');
 const answers = {};
 const showScreen = (name) => {
 screens.forEach(screen => {
 screen.classList.toggle(
 'is-active',
 screen.dataset.screen === name
 );
 });
 window.scrollTo({
 top: section.offsetTop,
 behavior: 'smooth'
 });
 };
 /\* NAVIGATION \*/
 section.querySelectorAll('[data-next]').forEach(button => {
 button.addEventListener('click', () => {
 if (button.dataset.answer) {
 const parent = button.closest('[data-screen]');
 if (parent) {
 answers[parent.dataset.screen] = button.dataset.answer;
 }
 }
 showScreen(button.dataset.next);
 });
 });
 section.querySelectorAll('[data-back]').forEach(button => {
 button.addEventListener('click', () => {
 showScreen(button.dataset.back);
 });
 });
 /\* PRODUCTS \*/
 const products = [
 {% for block in section.blocks %}
 {% assign p = block.settings.product %}
 {% if p != blank %}
 {
 object: {{ block.settings.object_name | json }},
 scent: {{ block.settings.scent_name | json }},
 text: {{ block.settings.result_text | json }},
 url: {{ p.url | json }},
 image:
 {% if block.settings.result_image != blank %}
 {{ block.settings.result_image | image_url: width: 1600 | json }}
 {% else %}
 {{ p.featured_image | image_url: width: 1600 | json }}
 {% endif %}
 },
 {% endif %}
 {% endfor %}
 ];
 /\* RESULT LOGIC \*/
 const calculateResult = () => {
 const scores = {
 "OBJECT 01": 0,
 "OBJECT 02": 0,
 "OBJECT 03": 0,
 "OBJECT 04": 0,
 "OBJECT 05": 0,
 "OBJECT 06": 0
 };
 /\* QUESTION 1 \*/
 if (answers.q1 === 'night') {
 scores["OBJECT 02"] += 3;
 scores["OBJECT 05"] += 2;
 }
 if (answers.q1 === 'green') {
 scores["OBJECT 03"] += 3;
 scores["OBJECT 04"] += 2;
 }
 if (answers.q1 === 'minimal') {
 scores["OBJECT 01"] += 3;
 scores["OBJECT 06"] += 1;
 }
 /\* QUESTION 2 \*/
 if (answers.q2 === 'steel') {
 scores["OBJECT 01"] += 3;
 scores["OBJECT 02"] += 1;
 }
 if (answers.q2 === 'wood') {
 scores["OBJECT 02"] += 3;
 scores["OBJECT 03"] += 1;
 }
 if (answers.q2 === 'glass') {
 scores["OBJECT 04"] += 2;
 scores["OBJECT 05"] += 2;
 scores["OBJECT 06"] += 2;
 }
 /\* QUESTION 3 \*/
 if (answers.q3 === 'calm') {
 scores["OBJECT 03"] += 3;
 scores["OBJECT 04"] += 2;
 scores["OBJECT 01"] += 1;
 }
 if (answers.q3 === 'drama') {
 scores["OBJECT 05"] += 4;
 scores["OBJECT 02"] += 2;
 }
 if (answers.q3 === 'chaos') {
 scores["OBJECT 06"] += 4;
 scores["OBJECT 05"] += 1;
 }
 /\* FIND WINNER \*/
 const winner = Object.keys(scores).reduce((best, current) => {
 return scores[current] > scores[best] ? current : best;
 });
 /\* FIND PRODUCT BY OBJECT NAME \*/
 const matchingProduct = products.find(product => {
 return product.object
 .trim()
 .toUpperCase() === winner;
 });
 return matchingProduct || products[0];
 };
 /\* FINAL QUESTION + RESULT \*/
 section.querySelectorAll('[data-result]').forEach(button => {
 button.addEventListener('click', () => {
 answers.q3 = button.dataset.answer;
 const result = calculateResult();
 if (!result) return;
 const resultTitle =
 section.querySelector('[data-result-title]');
 const resultShortTitle =
 section.querySelector('[data-result-short-title]');
 const resultSubtitle =
 section.querySelector('[data-result-subtitle]');
 const resultText =
 section.querySelector('[data-result-text]');
 const resultUrl =
 section.querySelector('[data-result-url]');
 const resultImage =
 section.querySelector('[data-result-image]');
 if (resultTitle) {
 resultTitle.textContent = result.object;
 }
 if (resultShortTitle) {
 resultShortTitle.textContent = result.object;
 }
 if (resultSubtitle) {
 resultSubtitle.textContent = result.scent;
 }
 if (resultText) {
 resultText.textContent = result.text;
 }
 if (resultUrl) {
 resultUrl.href = result.url;
 }
 if (resultImage) {
 resultImage.src = result.image;
 resultImage.alt = result.object;
 }
 showScreen('result');
 });
 });
 /\* RESTART \*/
 section.querySelector('[data-restart]')?.addEventListener('click', () => {
 Object.keys(answers).forEach(key => {
 delete answers[key];
 });
 showScreen('intro');
 });



});

</script>





