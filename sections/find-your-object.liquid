.fyo-screen--intro{position:relative;min-height:100svh;overflow:hidden;background:#111;color:#f5f2ea}.fyo-intro-media,.fyo-intro-shade,.fyo-intro-ui{position:absolute;inset:0}.fyo-intro-media img,.fyo-placeholder{width:100%;height:100%;min-height:100svh;object-fit:cover}.fyo-placeholder{background:#c9c4b9;display:flex;align-items:center;justify-content:center;color:#111}.fyo-intro-shade{background:linear-gradient(90deg,rgba(8,8,7,.78) 0%,rgba(8,8,7,.43) 42%,rgba(8,8,7,.06) 76%),linear-gradient(0deg,rgba(8,8,7,.62) 0%,transparent 40%)}.fyo-intro-ui{z-index:2;padding:28px 34px 24px;display:flex;flex-direction:column}.fyo-intro-meta{display:flex;justify-content:space-between;gap:20px;font-size:11px;line-height:1;letter-spacing:.08em;text-transform:uppercase}.fyo-intro-copy{margin:auto 0;max-width:1100px}.fyo-intro-copy h1{margin:0;font-size:clamp(70px,8.8vw,164px);line-height:.78;letter-spacing:-.075em;font-weight:500}.fyo-intro-kicker{margin:28px 0 0;font-size:clamp(22px,2vw,34px);line-height:1;letter-spacing:-.035em}.fyo-intro-desc{margin:18px 0 26px;max-width:470px;font-size:14px;line-height:1.35}.fyo-btn--hero{min-height:58px;padding:0 24px;border:1px solid currentColor;border-color:currentColor;color:currentColor;background:rgba(245,242,234,.02);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);display:inline-flex;align-items:center;justify-content:space-between;gap:34px;cursor:pointer;letter-spacing:.02em}.fyo-btn--hero:hover{background:#f5f2ea;color:#111}.fyo-intro-bottom{margin-top:auto}.fyo-marquee{overflow:hidden;border-top:1px solid rgba(245,242,234,.5);border-bottom:1px solid rgba(245,242,234,.5);padding:10px 0 9px}.fyo-marquee-track{display:flex;width:max-content;animation:fyo-marquee 22s linear infinite;font-size:11px;letter-spacing:.11em;white-space:nowrap}.fyo-marquee-track span{padding-right:1.2em}@keyframes fyo-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}.fyo-intro-proof{padding-top:11px;font-size:9px;letter-spacing:.12em;text-align:right}

