{% comment %}
  FIND YOUR OBJECT.
  Custom interactive quiz for NOT WHAT YOU EXPECT.
{% endcomment %}

<section
  id="find-your-object-{{ section.id }}"
  class="fyo"
  data-section-id="{{ section.id }}"
>

  <!-- INTRO -->
  <div class="fyo-screen fyo-screen--intro is-active" data-screen="intro">
    <div class="fyo-intro-copy">
      <div class="fyo-logo">NOT.</div>

      <h1>
        FIND<br>
        YOUR<br>
        OBJECT.
      </h1>

      <p>
        Don't choose a scent.<br>
        Choose a feeling.
      </p>

      <button class="fyo-btn" type="button" data-next="q1">
        START <span>→</span>
      </button>
    </div>

    <div class="fyo-intro-image">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            widths: '750, 1100, 1500, 1800',
            sizes: '(min-width: 900px) 60vw, 100vw'
        }}
      {% else %}
        <div class="fyo-placeholder">
          <span>ADD HERO IMAGE</span>
        </div>
      {% endif %}
    </div>
  </div>


  <!-- QUESTION 1 -->
  <div class="fyo-screen fyo-question" data-screen="q1">
    <div class="fyo-topbar">
      <div class="fyo-logo">NOT.</div>
      <div class="fyo-progress">01 / 03</div>
      <button class="fyo-link" type="button" data-back="intro">CLOSE</button>
    </div>

    <div class="fyo-question-wrap">
      <h2>WHERE WOULD YOU<br>RATHER BE RIGHT NOW?</h2>

      <div class="fyo-options fyo-options--3">

        <button
          class="fyo-option"
          type="button"
          data-answer="night"
          data-next="q2"
        >
          <div class="fyo-option-image">
            {% if section.settings.q1_image_1 != blank %}
              {{ section.settings.q1_image_1 | image_url: width: 900 | image_tag }}
            {% endif %}
          </div>
          <span>A HOTEL BAR<br>AT 1AM</span>
        </button>

        <button
          class="fyo-option"
          type="button"
          data-answer="green"
          data-next="q2"
        >
          <div class="fyo-option-image">
            {% if section.settings.q1_image_2 != blank %}
              {{ section.settings.q1_image_2 | image_url: width: 900 | image_tag }}
            {% endif %}
          </div>
          <span>A GARDEN<br>AFTER RAIN</span>
        </button>

        <button
          class="fyo-option"
          type="button"
          data-answer="minimal"
          data-next="q2"
        >
          <div class="fyo-option-image">
            {% if section.settings.q1_image_3 != blank %}
              {{ section.settings.q1_image_3 | image_url: width: 900 | image_tag }}
            {% endif %}
          </div>
          <span>SOMEWHERE WITH<br>NO WINDOWS</span>
        </button>

      </div>
    </div>
  </div>


  <!-- QUESTION 2 -->
  <div class="fyo-screen fyo-question" data-screen="q2">
    <div class="fyo-topbar">
      <div class="fyo-logo">NOT.</div>
      <div class="fyo-progress">02 / 03</div>
      <button class="fyo-link" type="button" data-back="q1">BACK</button>
    </div>

    <div class="fyo-question-wrap">
      <h2>PICK A MATERIAL.</h2>

      <div class="fyo-options fyo-options--3">

        <button
          class="fyo-option"
          type="button"
          data-answer="steel"
          data-next="q3"
        >
          <div class="fyo-material fyo-material--steel"></div>
          <span>STEEL</span>
        </button>

        <button
          class="fyo-option"
          type="button"
          data-answer="wood"
          data-next="q3"
        >
          <div class="fyo-material fyo-material--wood"></div>
          <span>DARK WOOD</span>
        </button>

        <button
          class="fyo-option"
          type="button"
          data-answer="glass"
          data-next="q3"
        >
          <div class="fyo-material fyo-material--glass"></div>
          <span>COLOURED GLASS</span>
        </button>

      </div>
    </div>
  </div>


  <!-- QUESTION 3 -->
  <div class="fyo-screen fyo-question" data-screen="q3">
    <div class="fyo-topbar">
      <div class="fyo-logo">NOT.</div>
      <div class="fyo-progress">03 / 03</div>
      <button class="fyo-link" type="button" data-back="q2">BACK</button>
    </div>

    <div class="fyo-question-wrap">
      <h2>YOUR HOME NEEDS MORE...</h2>

      <div class="fyo-options fyo-options--3">

        <button
          class="fyo-option"
          type="button"
          data-answer="calm"
          data-result
        >
          <div class="fyo-option-image">
            {% if section.settings.q3_image_1 != blank %}
              {{ section.settings.q3_image_1 | image_url: width: 900 | image_tag }}
            {% endif %}
          </div>
          <span>CALM</span>
        </button>

        <button
          class="fyo-option"
          type="button"
          data-answer="drama"
          data-result
        >
          <div class="fyo-option-image">
            {% if section.settings.q3_image_2 != blank %}
              {{ section.settings.q3_image_2 | image_url: width: 900 | image_tag }}
            {% endif %}
          </div>
          <span>DRAMA</span>
        </button>

        <button
          class="fyo-option"
          type="button"
          data-answer="chaos"
          data-result
        >
          <div class="fyo-option-image">
            {% if section.settings.q3_image_3 != blank %}
              {{ section.settings.q3_image_3 | image_url: width: 900 | image_tag }}
            {% endif %}
          </div>
          <span>CHAOS</span>
        </button>

      </div>
    </div>
  </div>


  <!-- RESULT -->
  <div class="fyo-screen fyo-result" data-screen="result">
    <div class="fyo-result-media">
      <img
        data-result-image
        src=""
        alt=""
        width="1200"
        height="1400"
        loading="lazy"
      >
    </div>

    <div class="fyo-result-copy">
      <div class="fyo-logo">NOT.</div>

      <p class="fyo-eyebrow">YOUR OBJECT IS...</p>

      <h2 data-result-title>OBJECT 02</h2>
      <h3 data-result-subtitle>Leather & Wood</h3>

      <p class="fyo-result-text" data-result-text></p>

      <a
        href="#"
        class="fyo-btn"
        data-result-url
      >
        DISCOVER <span data-result-short-title>OBJECT 02</span> →
      </a>

      <button
        type="button"
        class="fyo-restart"
        data-restart
      >
        NOT YOURS? START AGAIN
      </button>
    </div>
  </div>


  <!-- COLLECTION -->
  <div class="fyo-collection">
    <div class="fyo-collection-head">
      <div>
        <div class="fyo-logo">NOT.</div>
        <h2>
          EXPLORE THE<br>
          FULL COLLECTION.
        </h2>
      </div>
    </div>

    <div class="fyo-product-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          <a
            class="fyo-product"
            href="{{ product.url }}"
            {{ block.shopify_attributes }}
          >
            <div class="fyo-product-image">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy'
                }}
              {% endif %}
            </div>

            <div class="fyo-product-number">
              {{ block.settings.object_name }}
            </div>

            <div class="fyo-product-title">
              {{ block.settings.scent_name }}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</section>


<style>
#find-your-object-{{ section.id }} {
  --bg: #f1efe9;
  --text: #111111;
  --line: rgba(0,0,0,.15);

  background: var(--bg);
  color: var(--text);
  overflow: hidden;
}

#find-your-object-{{ section.id }} * {
  box-sizing: border-box;
}

#find-your-object-{{ section.id }} button,
#find-your-object-{{ section.id }} a {
  font: inherit;
}

.fyo-screen {
  display: none;
  min-height: 100vh;
  width: 100%;
}

.fyo-screen.is-active {
  display: grid;
}

.fyo-logo {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -.03em;
}

.fyo-screen--intro {
  grid-template-columns: 42% 58%;
  min-height: 100vh;
}

.fyo-intro-copy {
  padding: 34px;
  display: flex;
  flex-direction: column;
}

.fyo-intro-copy h1 {
  margin: auto 0 20px;
  font-size: clamp(70px, 8vw, 150px);
  line-height: .82;
  letter-spacing: -.075em;
  font-weight: 500;
}

.fyo-intro-copy p {
  font-size: 16px;
  line-height: 1.3;
  margin: 0 0 26px;
}

.fyo-btn {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 36px;
  background: transparent;
  border: 1px solid #111;
  color: #111;
  padding: 14px 18px;
  text-decoration: none;
  cursor: pointer;
  font-size: 13px;
  letter-spacing: .02em;
  text-transform: uppercase;
}

.fyo-btn:hover {
  background: #111;
  color: white;
}

.fyo-intro-image {
  min-height: 100vh;
  overflow: hidden;
}

.fyo-intro-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.fyo-placeholder {
  width: 100%;
  height: 100%;
  min-height: 100vh;
  background: #d7d4cc;
  display: flex;
  align-items: center;
  justify-content: center;
}


/* QUESTIONS */

.fyo-question {
  grid-template-rows: auto 1fr;
  padding: 30px;
}

.fyo-topbar {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
}

.fyo-progress {
  font-size: 12px;
  letter-spacing: .05em;
}

.fyo-link {
  justify-self: end;
  background: none;
  border: 0;
  cursor: pointer;
  font-size: 12px;
}

.fyo-question-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60px 0;
}

.fyo-question-wrap h2 {
  margin: 0 0 50px;
  font-size: clamp(38px, 4vw, 72px);
  line-height: .95;
  letter-spacing: -.05em;
  font-weight: 400;
  text-align: center;
}

.fyo-options {
  display: grid;
  gap: 14px;
}

.fyo-options--3 {
  grid-template-columns: repeat(3, 1fr);
}

.fyo-option {
  appearance: none;
  border: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.fyo-option-image,
.fyo-material {
  aspect-ratio: 1.22 / 1;
  overflow: hidden;
  background: #ddd;
}

.fyo-option-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s cubic-bezier(.2,.8,.2,1);
}

.fyo-option:hover img {
  transform: scale(1.025);
}

.fyo-option span {
  display: block;
  margin-top: 10px;
  font-size: 14px;
  line-height: 1.05;
}

.fyo-material--steel {
  background:
    linear-gradient(
      90deg,
      #aaa 0%,
      #e2e2e0 14%,
      #bcbcbc 27%,
      #f1f1ef 42%,
      #aaa 63%,
      #dededc 82%,
      #aaa 100%
    );
}

.fyo-material--wood {
  background:
    radial-gradient(
      ellipse at center,
      #3c271c 0%,
      #241710 60%,
      #110d0a 100%
    );
}

.fyo-material--glass {
  background:
    radial-gradient(
      circle at 35% 30%,
      #2457aa,
      #051532 55%,
      #020811
    );
}


/* RESULT */

.fyo-result {
  grid-template-columns: 52% 48%;
  min-height: 100vh;
  background: #0b0908;
  color: white;
}

.fyo-result-media {
  min-height: 100vh;
}

.fyo-result-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.fyo-result-copy {
  padding: 50px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.fyo-result-copy .fyo-logo {
  position: absolute;
  top: 35px;
}

.fyo-eyebrow {
  font-size: 12px;
  letter-spacing: .07em;
  margin-bottom: 20px;
}

.fyo-result-copy h2 {
  font-size: clamp(60px, 7vw, 130px);
  font-weight: 400;
  letter-spacing: -.06em;
  line-height: .9;
  margin: 0 0 20px;
}

.fyo-result-copy h3 {
  font-size: clamp(28px, 3vw, 52px);
  font-weight: 400;
  line-height: 1;
  margin: 0 0 26px;
}

.fyo-result-text {
  max-width: 430px;
  font-size: 16px;
  line-height: 1.4;
  margin-bottom: 34px;
}

.fyo-result .fyo-btn {
  border-color: white;
  color: white;
}

.fyo-result .fyo-btn:hover {
  background: white;
  color: black;
}

.fyo-restart {
  width: fit-content;
  border: 0;
  border-bottom: 1px solid rgba(255,255,255,.45);
  color: white;
  background: none;
  margin-top: 25px;
  padding: 0 0 3px;
  cursor: pointer;
  font-size: 11px;
}


/* COLLECTION */

.fyo-collection {
  padding: 90px 30px 120px;
  border-top: 1px solid var(--line);
}

.fyo-collection-head h2 {
  font-size: clamp(42px, 5vw, 90px);
  line-height: .9;
  letter-spacing: -.055em;
  font-weight: 400;
  margin: 50px 0 60px;
}

.fyo-product-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
}

.fyo-product {
  text-decoration: none;
  color: inherit;
}

.fyo-product-image {
  aspect-ratio: .82;
  overflow: hidden;
  background: #ddd;
}

.fyo-product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .45s ease;
}

.fyo-product:hover img {
  transform: scale(1.025);
}

.fyo-product-number {
  margin-top: 10px;
  font-size: 12px;
  font-weight: 600;
}

.fyo-product-title {
  margin-top: 3px;
  font-size: 11px;
  opacity: .7;
}


/* MOBILE */

@media screen and (max-width: 749px) {

  .fyo-screen--intro {
    grid-template-columns: 1fr;
    grid-template-rows: auto 48vh;
  }

  .fyo-intro-copy {
    min-height: 55vh;
    padding: 22px;
  }

  .fyo-intro-copy h1 {
    font-size: 64px;
    margin-top: 80px;
  }

  .fyo-intro-image {
    min-height: 48vh;
  }

  .fyo-question {
    padding: 20px;
  }

  .fyo-question-wrap {
    justify-content: flex-start;
    padding-top: 70px;
  }

  .fyo-question-wrap h2 {
    font-size: 38px;
    text-align: left;
    margin-bottom: 28px;
  }

  .fyo-options--3 {
    grid-template-columns: 1fr;
  }

  .fyo-option-image,
  .fyo-material {
    aspect-ratio: 1.7;
  }

  .fyo-option {
    margin-bottom: 18px;
  }

  .fyo-result {
    grid-template-columns: 1fr;
  }

  .fyo-result-media {
    min-height: 55vh;
    height: 55vh;
  }

  .fyo-result-copy {
    padding: 40px 22px 70px;
  }

  .fyo-result-copy .fyo-logo {
    position: static;
    margin-bottom: 70px;
  }

  .fyo-result-copy h2 {
    font-size: 64px;
  }

  .fyo-product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 10px;
  }

  .fyo-collection {
    padding: 70px 20px;
  }

}
</style>


<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#find-your-object-{{ section.id }}');

  if (!section) return;

  const screens = section.querySelectorAll('[data-screen]');
  const answers = {};

  const showScreen = (name) => {
    screens.forEach(screen => {
      screen.classList.toggle(
        'is-active',
        screen.dataset.screen === name
      );
    });

    window.scrollTo({
      top: section.offsetTop,
      behavior: 'smooth'
    });
  };

  section.querySelectorAll('[data-next]').forEach(button => {
    button.addEventListener('click', () => {
      if (button.dataset.answer) {
        const parent = button.closest('[data-screen]');
        answers[parent.dataset.screen] = button.dataset.answer;
      }

      showScreen(button.dataset.next);
    });
  });

  section.querySelectorAll('[data-back]').forEach(button => {
    button.addEventListener('click', () => {
      showScreen(button.dataset.back);
    });
  });


  const products = [

    {% for block in section.blocks %}
      {% assign p = block.settings.product %}

      {% if p != blank %}
        {
          object: {{ block.settings.object_name | json }},
          scent: {{ block.settings.scent_name | json }},
          text: {{ block.settings.result_text | json }},
          url: {{ p.url | json }},
          image:
            {% if block.settings.result_image != blank %}
              {{ block.settings.result_image | image_url: width: 1600 | json }}
            {% else %}
              {{ p.featured_image | image_url: width: 1600 | json }}
            {% endif %}
        },
      {% endif %}
    {% endfor %}

  ];


  const calculateResult = () => {

    const q1 = answers.q1;
    const q2 = answers.q2;
    const q3 = answers.q3;

    let index = 0;

    /*
      RESULT LOGIC

      0 = OBJECT 01
      1 = OBJECT 02
      2 = OBJECT 03
      3 = OBJECT 04
      4 = OBJECT 05
      5 = OBJECT 06
    */

    if (q1 === 'night') {
      if (q2 === 'wood') index = 1;
      else if (q2 === 'glass') index = 4;
      else index = 0;
    }

    if (q1 === 'green') {
      if (q3 === 'calm') index = 2;
      else if (q2 === 'glass') index = 3;
      else index = 0;
    }

    if (q1 === 'minimal') {
      if (q3 === 'drama') index = 4;
      else if (q3 === 'chaos') index = 5;
      else index = 0;
    }

    if (q3 === 'chaos' && q2 === 'glass') {
      index = 5;
    }

    if (q3 === 'calm' && q2 === 'glass') {
      index = 3;
    }

    return products[index] || products[0];
  };


  section.querySelectorAll('[data-result]').forEach(button => {
    button.addEventListener('click', () => {

      answers.q3 = button.dataset.answer;

      const result = calculateResult();

      if (!result) return;

      section.querySelector('[data-result-title]').textContent =
        result.object;

      section.querySelector('[data-result-short-title]').textContent =
        result.object;

      section.querySelector('[data-result-subtitle]').textContent =
        result.scent;

      section.querySelector('[data-result-text]').textContent =
        result.text;

      section.querySelector('[data-result-url]').href =
        result.url;

      const image = section.querySelector('[data-result-image]');

      image.src = result.image;
      image.alt = result.object;

      showScreen('result');
    });
  });


  section.querySelector('[data-restart]')?.addEventListener('click', () => {
    Object.keys(answers).forEach(key => delete answers[key]);
    showScreen('intro');
  });

});
</script>


{% schema %}
{
  "name": "Find your object",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },

    {
      "type": "header",
      "content": "Question 1 images"
    },
    {
      "type": "image_picker",
      "id": "q1_image_1",
      "label": "Hotel bar"
    },
    {
      "type": "image_picker",
      "id": "q1_image_2",
      "label": "Garden after rain"
    },
    {
      "type": "image_picker",
      "id": "q1_image_3",
      "label": "Somewhere with no windows"
    },

    {
      "type": "header",
      "content": "Question 3 images"
    },
    {
      "type": "image_picker",
      "id": "q3_image_1",
      "label": "Calm"
    },
    {
      "type": "image_picker",
      "id": "q3_image_2",
      "label": "Drama"
    },
    {
      "type": "image_picker",
      "id": "q3_image_3",
      "label": "Chaos"
    }
  ],

  "blocks": [
    {
      "type": "object",
      "name": "Object",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "object_name",
          "label": "Object name",
          "default": "OBJECT 01"
        },
        {
          "type": "text",
          "id": "scent_name",
          "label": "Scent name",
          "default": "Citrus & Ambre"
        },
        {
          "type": "textarea",
          "id": "result_text",
          "label": "Result text",
          "default": "Unexpected, distinctive, and apparently very you."
        },
        {
          "type": "image_picker",
          "id": "result_image",
          "label": "Result image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Find your object",
      "blocks": [
        { "type": "object" },
        { "type": "object" },
        { "type": "object" },
        { "type": "object" },
        { "type": "object" },
        { "type": "object" }
      ]
    }
  ]
}
{% endschema %}