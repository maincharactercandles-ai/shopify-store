{% comment %}
===========================================================
NWYE — FIND US IN THE WILD + RETAILER REVIEWS
Custom Liquid section
===========================================================

IMAGES:
1. Upload your retailer photos to Shopify:
   Content > Files
2. Copy each Shopify CDN URL
3. Replace the 5 URLs below.

===========================================================
{% endcomment %}




<style>

  /* ======================================================
     NWYE — GLOBAL
     ====================================================== */

  .nwye-retail {
    --nwye-black: #292929;
    --nwye-grey: #969696;
    --nwye-light-grey: #dcdcdc;
    --nwye-bg: #ffffff;

    width: 100%;
    background: var(--nwye-bg);
    color: var(--nwye-black);
    overflow: hidden;
  }

  .nwye-retail *,
  .nwye-retail *::before,
  .nwye-retail *::after {
    box-sizing: border-box;
  }

  .nwye-retail__container {
    width: min(100% - 64px, 1480px);
    margin: 0 auto;
  }


  /* ======================================================
     TYPOGRAPHY
     ====================================================== */

  .nwye-retail__eyebrow {
    margin: 0 0 25px;

    font-size: 10px;
    line-height: 1;

    letter-spacing: .30em;
    text-transform: uppercase;

    color: #9a9a9a;
  }

  .nwye-retail__headline {
    margin: 0;

    max-width: 620px;

    font-size: clamp(58px, 5.4vw, 92px);
    line-height: .88;

    font-weight: 800;
    letter-spacing: -.065em;

    text-transform: uppercase;
  }

  .nwye-retail__description {
    max-width: 420px;

    margin: 28px 0 0;

    font-size: 18px;
    line-height: 1.4;

    letter-spacing: -.02em;
  }


  /* ======================================================
     HERO
     ====================================================== */

  .nwye-retail__hero {
    display: grid;

    grid-template-columns:
      minmax(320px, .85fr)
      minmax(500px, 1.15fr);

    gap: 70px;

    align-items: center;

    padding-top: 90px;
    padding-bottom: 60px;
  }


  /* ======================================================
     MAP
     ====================================================== */

  .nwye-map {
    position: relative;

    width: 100%;
    max-width: 720px;

    margin-left: auto;

    aspect-ratio: 1.72 / 1;
  }


  .nwye-map__svg {
    position: absolute;

    width: 76%;
    height: 92%;

    left: 12%;
    top: 2%;
  }


  .nwye-map__svg svg {
    width: 100%;
    height: 100%;
  }


  .nwye-map__svg path {
    fill: none;

    stroke: #b2b2b2;
    stroke-width: 1.2;

    vector-effect: non-scaling-stroke;
  }


  /* ======================================================
     MAP PINS
     ====================================================== */

  .nwye-map__pin {
    position: absolute;

    display: flex;
    align-items: center;

    gap: 11px;

    font-size: 10px;
    line-height: 1;

    letter-spacing: .24em;
    text-transform: uppercase;

    font-weight: 600;

    white-space: nowrap;
  }


  .nwye-map__pin::before {
    content: "";

    display: block;

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #111;

    flex-shrink: 0;
  }


  .nwye-map__pin::after {
    content: "";

    position: absolute;

    top: 50%;

    height: 1px;

    background: #777;

    z-index: -1;
  }


  /* BRISTOL */

  .nwye-map__pin--bristol {
    left: 11%;
    top: 35%;

    flex-direction: row-reverse;
  }

  .nwye-map__pin--bristol::after {
    width: 65px;
    right: 3px;
  }


  /* PARIS */

  .nwye-map__pin--paris {
    left: 17%;
    top: 51%;

    flex-direction: row-reverse;
  }

  .nwye-map__pin--paris::after {
    width: 63px;
    right: 3px;
  }


  /* BERLIN */

  .nwye-map__pin--berlin {
    left: 49%;
    top: 36%;
  }

  .nwye-map__pin--berlin::after {
    width: 82px;
    left: 3px;
  }


  /* STOCKHOLM */

  .nwye-map__pin--stockholm {
    left: 55%;
    top: 11%;
  }

  .nwye-map__pin--stockholm::after {
    width: 82px;
    left: 3px;
  }


  /* ATHENS */

  .nwye-map__pin--athens {
    left: 67%;
    top: 75%;
  }

  .nwye-map__pin--athens::after {
    width: 95px;
    left: 3px;
  }



  /* ======================================================
     STORES GRID
     ====================================================== */

  .nwye-stores {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    border-top: 1px solid var(--nwye-light-grey);
    border-bottom: 1px solid var(--nwye-light-grey);
  }


  .nwye-store {
    display: flex;
    flex-direction: column;

    min-width: 0;

    border-right: 1px solid var(--nwye-light-grey);
  }


  .nwye-store:first-child {
    border-left: 1px solid var(--nwye-light-grey);
  }


  /* ======================================================
     STORE IMAGE
     ====================================================== */

  .nwye-store__image-wrap {
    width: 100%;

    aspect-ratio: 1.18 / 1;

    overflow: hidden;

    background: #f1f1f1;
  }


  .nwye-store__image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    filter: saturate(.82);

    transition:
      transform .55s cubic-bezier(.2,.7,.2,1),
      filter .35s ease;
  }


  .nwye-store:hover .nwye-store__image {
    transform: scale(1.025);

    filter: saturate(1);
  }


  /* Placeholder if image URL isn't added */

  .nwye-store__placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: #f4f4f4;

    color: #aaa;

    text-align: center;

    font-size: 9px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }


  /* ======================================================
     STORE TEXT
     ====================================================== */

  .nwye-store__content {
    display: flex;
    flex-direction: column;

    flex: 1;

    min-height: 190px;

    padding: 27px 25px 28px;
  }


  .nwye-store__city {
    margin: 0 0 13px;

    font-size: 9px;
    line-height: 1;

    letter-spacing: .27em;
    text-transform: uppercase;

    color: #8f8f8f;
  }


  .nwye-store__name {
    margin: 0;

    font-size: clamp(19px, 1.45vw, 25px);
    line-height: .98;

    font-weight: 700;

    letter-spacing: -.04em;

    text-transform: uppercase;
  }



  .nwye-store__link {
    width: fit-content;

    margin-top: auto;

    padding-bottom: 2px;

    color: inherit;

    text-decoration: none;

    font-size: 9px;

    font-weight: 600;

    letter-spacing: .23em;

    text-transform: uppercase;
  }

.nwye-stores .nwye-store__line,
.nwye-stores .nwye-store__arrow {
  display: none;
}


  /* ======================================================
     REVIEWS SECTION
     ====================================================== */

  .nwye-reviews {
    display: grid;

    grid-template-columns:
      minmax(430px, .72fr)
      minmax(400px, 1.78fr);

    gap: 65px;

    padding-top: 35px;
    padding-bottom: 90px;
  }


  .nwye-reviews__headline {
    margin: 0;

    max-width: 430px;

    font-size: clamp(52px, 4.5vw, 75px);
    line-height: .87;

    font-weight: 800;

    letter-spacing: -.065em;

    text-transform: uppercase;
  }


  .nwye-reviews__intro {
    max-width: 410px;

    margin: 27px 0 0;

    font-size: 16px;
    line-height: 1.45;

    letter-spacing: -.015em;

    color: #555;
  }



  /* ======================================================
     REVIEW GRID
     ====================================================== */
/* Section */
.nwye-reviews {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
  align-items: start;
  gap: clamp(28px, 4vw, 64px);
  padding-block: clamp(28px, 3vw, 44px);
}

.nwye-reviews__headline {
  max-width: none;
  font-size: clamp(40px, 4vw, 62px);
  line-height: 0.96;
}

.nwye-reviews__intro {
  margin-top: 16px;
}

/* Deux avis empilés */
.nwye-reviews .nwye-review-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18px;
}

.nwye-reviews .nwye-review {
  display: grid;
  justify-items: start;
  align-content: start;
  gap: 8px;
  min-height: 0;
  padding: 0;
  border: 0;
  text-align: left;
}

.nwye-reviews .nwye-review + .nwye-review {
  padding-top: 18px;
  border-top: 1px solid #ddd;
}

/* Étoiles et citation sur le même axe */
.nwye-reviews .nwye-review__stars {
  margin: 0;
  font-size: 15px;
  line-height: 1;
  letter-spacing: 0.08em;
}

.nwye-reviews blockquote,
.nwye-reviews blockquote p {
  margin: 0;
  padding: 0;
  border: 0;
}

.nwye-reviews blockquote {
  max-width: 68ch;
  font-size: clamp(16px, 1.2vw, 18px);
  line-height: 1.45;
  font-style: normal;
}

/* Signature */
.nwye-reviews .nwye-review__meta {
  margin: 4px 0 0;
  padding: 0;
}

.nwye-reviews .nwye-review__meta::before {
  display: none;
}

.nwye-reviews .nwye-review__retailer {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0;
  text-transform: none;
}

.nwye-reviews .nwye-review__source {
  margin-top: 2px;
  color: #666;
  font-size: 12px;
  line-height: 1.4;
  letter-spacing: 0;
  text-transform: none;
}

@media (max-width: 750px) {
  .nwye-reviews {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}


  /* ======================================================
     TABLET
     ====================================================== */

  @media screen and (max-width: 1100px) {

    .nwye-retail__hero {
      grid-template-columns: 1fr;
      gap: 10px;
    }


    .nwye-map {
      margin: 0 auto;
      max-width: 760px;
    }

/* Photos panoramiques, même hauteur pour les quatre boutiques */
.nwye-stores .nwye-store .nwye-store__image-wrap {
  display: block;
  aspect-ratio: 16 / 9;
  height: auto;
  overflow: hidden;
}

.nwye-stores .nwye-store__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Légende compacte */
.nwye-stores .nwye-store__content {
  flex: 0 0 auto;
  min-height: 0;
  padding: 16px 20px 18px;
}

.nwye-stores .nwye-store__city {
  margin: 0 0 6px;
  color: #686868;
  font-size: 10px;
  letter-spacing: 0.15em;
}

.nwye-stores .nwye-store__name {
  margin: 0;
  font-size: clamp(17px, 1.4vw, 22px);
  font-weight: 700;
  line-height: 1.1;
}

.nwye-stores .nwye-store__line {
  display: none;
}

.nwye-stores .nwye-store__link {
  margin-top: 12px;
  padding-bottom: 3px;
  font-size: 10px;
  letter-spacing: 0.1em;
}

/* Mobile : quatre cartes en grille 2 × 2 */
@media (max-width: 650px) {
  .nwye-stores {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .nwye-stores .nwye-store:last-child {
    display: flex;
    grid-column: auto;
  }

  .nwye-stores .nwye-store__content {
    padding: 12px 14px 14px;
  }
}

    .nwye-reviews {
      grid-template-columns: 1fr;
      gap: 55px;
    }

  }



  /* ======================================================
     MOBILE
     ====================================================== */

  @media screen and (max-width: 650px) {

    .nwye-retail__container {
      width: calc(100% - 32px);
    }


    .nwye-retail__hero {
      padding-top: 58px;
      padding-bottom: 45px;
    }


    .nwye-retail__eyebrow {
      margin-bottom: 18px;

      font-size: 8px;
    }


    .nwye-retail__headline {
      font-size: clamp(45px, 14vw, 58px);
    }


    .nwye-retail__description {
      max-width: 330px;

      margin-top: 23px;

      font-size: 15px;
    }


    /* MAP */

    .nwye-map {
      width: 110%;

      margin-left: -5%;

      aspect-ratio: 1.25 / 1;
    }


    .nwye-map__pin {
      font-size: 6.5px;

      letter-spacing: .15em;

      gap: 6px;
    }


    .nwye-map__pin::before {
      width: 5px;
      height: 5px;
    }


    /* STORES */

    .nwye-stores {
      grid-template-columns: 1fr 1fr;
    }


    .nwye-store__content {
      min-height: 155px;

      padding: 20px 16px;
    }


    .nwye-store__city {
      font-size: 7px;
    }


    .nwye-store__name {
      font-size: 17px;
    }


    .nwye-store__link {
      font-size: 7px;
    }


    /* Last store spans width */

    .nwye-store:last-child {
      grid-column: 1 / -1;

      display: grid;

      grid-template-columns: 1fr 1fr;
    }


    .nwye-store:last-child .nwye-store__image-wrap {
      aspect-ratio: auto;
      height: 100%;
    }


    /* REVIEWS */

    .nwye-reviews {
      padding-top: 60px;
      padding-bottom: 55px;
    }


    .nwye-reviews__headline {
      font-size: clamp(45px, 13vw, 58px);
    }


    .nwye-reviews__intro {
      font-size: 15px;
    }


    .nwye-review-grid {
      grid-template-columns: 1fr;
    }


    .nwye-review {
      min-height: auto;

      padding: 30px 0;

      border-left: 0;

      border-top: 1px solid var(--nwye-light-grey);
    }


    .nwye-review__quote {
      max-width: 430px;

      font-size: 17px;
    }


    .nwye-review__meta {
      margin-top: 32px;

      padding-top: 0;
    }

  }


  .nwye-merci {
    display: grid;
    grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
    align-items: center;
    gap: clamp(16px, 2vw, 36px);
    padding-block: clamp(24px, 3vw, 46px);
    border-block: 1px solid var(--nwye-light-grey);
  }
  .nwye-merci__copy { text-align: center; padding: 18px 8px; }
  .nwye-merci__copy:only-child { grid-column: 1 / -1; }
.nwye-merci__label {
  display: block;
  font-size: clamp(18px, 2vw, 28px);
  font-weight: 600;
  letter-spacing: 0.12em;
}  .nwye-merci__logo { display: block; width: min(78%, 375px); height: auto; margin: 16px auto; }
  .nwye-merci__note { margin: 0; }
.nwye-merci__links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px clamp(24px, 6vw, 40px);
  margin-top: 40px;
}

.nwye-merci__links a {
  white-space: nowrap;
}
.nwye-merci__links a span[aria-hidden="true"] {
  display: none;
}
  .nwye-merci__photo { display: block; width: 100%; height: auto; }
  @media (max-width: 700px) {
    .nwye-merci { grid-template-columns: 1fr; gap: 18px; }
    .nwye-merci__logo { width: min(68%, 290px); }
  }
  .nwye-europe {display:block; width:100%; max-width:550px; margin-inline:auto; height:auto;}
  .nwye-europe text {font:600 17px sans-serif; fill:#292929; paint-order:stroke; stroke:#fff; stroke-width:4px; stroke-linejoin:round;}
  @media(max-width:650px){.nwye-europe text{font-size:23px;} .nwye-merci__note{font-size:10px; margin-bottom:16px;}}
  .nwye-stores .nwye-store__content {
  flex: none;
  min-height: 0;
  padding: 14px 20px;
  gap: 0;
}

.nwye-stores .nwye-store__link {
  margin-top: 8px;
}

</style>



